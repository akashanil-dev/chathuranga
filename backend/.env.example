# SENSE Backend Environment Variables

# --- Primary: local Qwen3-VL-2B via Ollama (run once: ollama pull qwen3-vl:2b) ---
# Use 127.0.0.1, not localhost (localhost adds ~2 s on Windows via IPv6 fallback)
OLLAMA_URL=http://127.0.0.1:11434
VLM_MODEL=qwen3-vl:2b
# Longest image side sent to the model (smaller = faster)
VLM_IMAGE_MAX_SIDE=448
# Seconds before the local model is treated as failed and Claude is tried
VLM_TIMEOUT_S=6
# Set to false to skip the local model and use Claude only
LOCAL_VLM_ENABLED=true

# --- Fallback: Anthropic Claude (used when the local model fails / is unreachable) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
CLAUDE_TIMEOUT_S=8

PORT=8000
HOST=0.0.0.0
